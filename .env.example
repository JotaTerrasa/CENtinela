# Copia este archivo como .env. CENtinela usa exclusivamente la sesión de
# ChatGPT/Codex persistida por `codex login`; no acepta OPENAI_API_KEY.
CODEX_CLI_PATH=codex
CODEX_TIMEOUT_SECONDS=240

# Planner y filtro son deterministas por defecto. Luna responde el RAG, Terra
# evalúa el informe y Sol lo redacta; estas variables conservan puntos de
# extensión explícitos para Planner/filtro generativos inyectados.
PLANNER_MODEL=gpt-5.6-luna
FILTER_MODEL=gpt-5.6-luna
JUDGE_MODEL=gpt-5.6-terra
REPORT_MODEL=gpt-5.6-sol
PLANNER_REASONING_EFFORT=low
FILTER_REASONING_EFFORT=low
JUDGE_REASONING_EFFORT=medium
REPORT_REASONING_EFFORT=high
EMBEDDING_MODEL=local-hash-1536

# Persistencia local del MVP.
DATABASE_PATH=data/centinela.db
CHROMA_PATH=data/chroma
REPORTS_PATH=reports
CODEX_WORKDIR=data/codex-work

# Costes y límites operativos.
USD_TO_CLP=940
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_ARTICLES=8
RAG_TOP_K=5

# Identidad y operación.
APP_NAME=CENtinela
APP_ENV=development
LOG_LEVEL=INFO
BUSINESS_TIMEZONE=America/Santiago

# Opcional: cuenta inicial creada solo si ambos valores están presentes.
# Si se dejan vacíos, el primer usuario se crea desde la pantalla de registro.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
