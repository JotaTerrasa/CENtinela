# Copia este archivo como .env. El perfil predeterminado conserva Codex con una
# sesión ChatGPT; también están soportados OpenAI API, Ollama y vLLM.
AI_PROVIDER=codex
EMBEDDING_PROVIDER=local_hash

# Opcional: cada rol puede usar un proveedor distinto. Vacío hereda AI_PROVIDER.
PLANNER_PROVIDER=
FILTER_PROVIDER=
REPORT_PROVIDER=
JUDGE_PROVIDER=
PROVIDER_TIMEOUT_SECONDS=240
PROVIDER_HEALTH_TIMEOUT_SECONDS=5

# Codex + ChatGPT. No necesita OPENAI_API_KEY.
CODEX_CLI_PATH=codex
CODEX_TIMEOUT_SECONDS=240
PLANNER_MODEL=gpt-5.6-luna
FILTER_MODEL=gpt-5.6-luna
JUDGE_MODEL=gpt-5.6-terra
REPORT_MODEL=gpt-5.6-sol
EMBEDDING_MODEL=local-hash-1536

# OpenAI API. La API se factura aparte de cualquier suscripción ChatGPT.
# Define OPENAI_API_KEY mediante un secret manager en producción.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PLANNER_MODEL=gpt-4o-mini
OPENAI_FILTER_MODEL=gpt-4o-mini
OPENAI_REPORT_MODEL=gpt-4o
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama. En Docker el override docker-compose.ollama.yml sustituye la URL por
# http://ollama:11434/v1 y descarga los dos modelos del perfil de demo.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_PLANNER_MODEL=qwen3.5:9b
OLLAMA_FILTER_MODEL=qwen3.5:9b
OLLAMA_REPORT_MODEL=qwen3.5:9b
OLLAMA_JUDGE_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# vLLM u otro gateway OpenAI-compatible. En producción debe ser un endpoint
# privado con autenticación de servicio y routing por modelo.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=
VLLM_PLANNER_MODEL=Qwen/Qwen3.5-9B
VLLM_FILTER_MODEL=Qwen/Qwen3.5-9B
VLLM_REPORT_MODEL=Qwen/Qwen3.5-9B
VLLM_JUDGE_MODEL=Qwen/Qwen3.5-9B
VLLM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Esfuerzo efectivo en Codex y en backends que lo soporten. GPT-4o/4o-mini lo
# omiten; las versiones actuales fijadas de Ollama y vLLM sí lo aceptan.
PLANNER_REASONING_EFFORT=low
FILTER_REASONING_EFFORT=low
JUDGE_REASONING_EFFORT=medium
REPORT_REASONING_EFFORT=high

# Estimación opcional de infraestructura self-hosted. Se presenta separada del
# coste API exacto; vacío significa que el coste de cómputo no está configurado.
SELF_HOSTED_COMPUTE_USD_PER_HOUR=

# Persistencia local del MVP.
DATABASE_PATH=data/centinela.db
CHROMA_PATH=data/chroma
REPORTS_PATH=reports
CODEX_WORKDIR=data/codex-work

# Costes y límites operativos.
USD_TO_CLP=940
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_ARTICLES=8
RAG_TOP_K=5

# Identidad y operación.
APP_NAME=CENtinela
APP_ENV=development
# Solo para la demo pública de solo lectura: carga en memoria los artefactos
# validados de docs/demo, sin SQLite, y bloquea todas las acciones externas.
PUBLIC_DEMO_MODE=false
LOG_LEVEL=INFO
BUSINESS_TIMEZONE=America/Santiago

# Opcional: cuenta inicial creada solo si ambos valores están presentes.
# En APP_ENV=production se exige un proveedor de identidad externo en el roadmap.
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
